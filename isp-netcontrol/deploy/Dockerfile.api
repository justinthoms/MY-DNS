# Build context: the package root (the directory holding go.mod).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY shared ./shared
COPY isp-netcontrol ./isp-netcontrol
# Refuse to build a product that trusts no License Manager key.
RUN grep -q "BEGIN MYDNS LICENSE SIGNING KEY" isp-netcontrol/internal/license/trusted_keys.go \
 || (echo "ERROR: run isp-netcontrol/scripts/set-trusted-keys.sh before building" >&2; exit 1)
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/isp-netcontrol ./isp-netcontrol/cmd/isp-netcontrol

FROM alpine:3.22
# nftables: the API manages its own nft table on the host (network_mode: host).
RUN apk add --no-cache ca-certificates tzdata nftables wget
COPY --from=build /out/isp-netcontrol /usr/local/bin/isp-netcontrol
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1:8081/healthz >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/isp-netcontrol"]
