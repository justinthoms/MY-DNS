# ISP NetControl configuration. scripts/install.sh generates this file.

POSTGRES_PASSWORD=change-me
# Local port for PostgreSQL (bound to 127.0.0.1 only).
PG_PORT=5433

# 32 random bytes, base64. Encrypts TOTP secrets and keys the license state
# integrity check. Never change it after installation.
NC_MASTER_KEY=

# First administrator (used only while none exists).
NC_BOOTSTRAP_ADMIN_EMAIL=admin@isp.example
NC_BOOTSTRAP_ADMIN_PASSWORD=

# Where DNS is served (UDP and TCP). ":53" means every IPv4 and IPv6 address.
NC_DNS_LISTEN=:53

# Manage the nftables table "inet isp_netcontrol" (true/false).
NC_FIREWALL_ENABLED=true

# License Manager URL for online activation and status sync (optional).
NC_LM_URL=https://licenses.vendor.example
# CA certificate for a License Manager with a private certificate, as seen
# inside the container (install.sh mounts it at /etc/isp-netcontrol/lm-ca.pem).
NC_LM_CA_FILE=
NC_SYNC_INTERVAL=6h

NC_REQUIRE_TOTP=true
NC_QUERY_LOG_DAYS=7

HTTP_PORT=80
HTTPS_PORT=443
TLS_DIR=./tls
NC_STATE_HOST_DIR=/var/lib/isp-netcontrol
